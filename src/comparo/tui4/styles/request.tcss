/* Request-specific overview hierarchy. */
.request-context-strip {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}
.request-target-pill {
    width: auto;
    max-width: 80%;
    height: 1;
    margin-right: 1;
    overflow-x: hidden;
    text-overflow: ellipsis;
}
.request-context-badge {
    margin-right: 1;
}

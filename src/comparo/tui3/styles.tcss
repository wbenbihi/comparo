/* tui3 — v0 mockup look. Tokens come from theme.py via registered themes. */

Screen { background: $background; color: $foreground; }

/* chrome */
.navrow {
    height: 2; padding: 0 1;
    background: $surface;
    border-bottom: solid $t3-line;
}
.navrow .logo { color: $accent; text-style: bold; width: auto; margin-right: 2; }
.nav-tab { width: auto; color: $t3-dim; padding: 0 1; margin-right: 1; }
.nav-tab:hover { color: $foreground; }
.nav-tab.-on { color: $accent; text-style: bold; background: $t3-panel-hi; }
.nav-crumb { width: 1fr; color: $t3-dim; padding-left: 1; }
.nav-tier { width: auto; color: $accent; padding: 0 1; }
.footrow { dock: bottom; height: 2; background: $surface; border-top: solid $t3-line; padding: 0 1; }
#body { height: 1fr; padding: 1; }

/* panels */
.t3-panel {
    border: round $t3-line;
    background: $surface;
    padding: 0 1;
    height: 1fr;
    scrollbar-size-vertical: 1;
}
.t3-panel.-hi { background: $t3-panel-hi; }
.t3-panel.-auto { height: auto; }
.t3-panel:focus-within { border: round $accent; }
.panel-header { height: 1; }
.split-row { height: 1; }
TextRow { height: auto; }

/* lists */
.cursor-list { height: 1fr; scrollbar-size-vertical: 1; }
.cursor-list _RowStatic { height: 1; }
_RowStatic { height: 1; }
_RowStatic:hover { background: $t3-hover; }
.row-cursor { background: $t3-cursor; }

/* seg + chips */
.seg { height: 1; width: auto; }
.shell-head { height: 1; }
.shell-head TextRow { width: auto; margin-right: 2; }
.seg-opt { width: auto; }
.seg-opt:hover { color: $foreground; }
.chip-row { height: auto; width: 1fr; }
.chip { width: auto; margin-right: 1; padding: 0 1; border: round $t3-line; height: 3; }
.chip:hover { border: round $accent; }

/* filter */
.filter-input {
    height: 1; border: none; padding: 0 1;
    background: $t3-panel-hi; color: $foreground; margin-bottom: 1;
}
.filter-input:focus { background: $t3-input-focus; }

/* layout helpers */
.cols { height: 1fr; }
.col-left { width: 42; }
.col-left-wide { width: 1fr; }
.col-right { width: 1fr; }
.col-right-narrow { width: 52; }
.stack-auto { height: auto; }
.mb1 { margin-bottom: 1; }

/* Matrix, Schema, and Value inspectors are continuous resource documents. */
.matrix-context-strip,
.schema-context-strip,
.value-context-strip {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.matrix-context-badge,
.schema-context-badge,
.value-context-badge {
    margin-right: 1;
}

.matrix-section-body,
.schema-section-body,
.value-section-body {
    width: 100%;
    height: auto;
    background: transparent;
}

.resource-section-heading {
    margin-top: 1;
}

.matrix-section-body,
.schema-section-body,
.value-section-body {
    min-height: 2;
    padding: 0 1;
}

.matrix-exclusions,
.matrix-plan-context {
    width: 100%;
    height: auto;
    padding: 0 1;
}

.matrix-plan-table,
.matrix-usage-table,
.schema-properties-table,
.schema-usage-table,
.value-inputs-table,
.value-usage-table {
    height: auto;
    min-height: 2;
    max-height: 14;
}

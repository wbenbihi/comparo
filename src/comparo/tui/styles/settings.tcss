SettingsWorkspace { padding: 0 1; }
#settings-layout { height: 1fr; }
#settings-nav { width: 28; height: 1fr; margin-right: 1; }
#settings-editor { width: 1fr; }
#settings-editor Panel { margin-bottom: 1; }
#settings-editor SelectField { height: 2; margin: 1 0; }
#settings-editor Caption { height: auto; margin-bottom: 1; }
#settings-notice { height: auto; max-height: 3; }
Screen.density-compact SectionTitle { margin-top: 0; }
Screen.density-compact .project-setting-row { margin-bottom: 0; }
Screen.density-compact Separator { margin: 0; }
Screen.density-compact #settings-editor SelectField { margin: 0; }
Screen.density-compact #settings-editor Panel { margin-bottom: 0; }
AppHeader.compact-header { grid-columns: auto 1fr; grid-gutter: 0 1; }
AppHeader.compact-header NavHelper { display: none; }
AppHeader.compact-header NavTab { padding: 0; margin-right: 1; }
